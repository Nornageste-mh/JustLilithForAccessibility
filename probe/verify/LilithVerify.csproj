<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LilithVerify</AssemblyName>
    <RootNamespace>LilithVerify</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Version>0.0.1.0</Version>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(LilithGameDir)\BepInEx\core\BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(LilithGameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(LilithGameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(LilithGameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(LilithGameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(LilithGameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(LilithGameDir)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
